# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dustyshelf?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Firebase Service Account (JSON string)
# You can get this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Copy the JSON content and paste it here as a single line string.
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "..." , ...}

# Cloudinary (Optional for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
